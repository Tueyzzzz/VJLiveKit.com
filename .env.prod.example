# ตัวอย่าง .env สำหรับ production (/opt/vjlivekit/.env)
# ปกติไม่ต้องสร้างเอง: deploy/bootstrap.sh จะสร้างให้ครั้งแรกพร้อมรหัสสุ่ม
NODE_ENV=production
PORT=8080
DOMAIN=vjlivekit.com
PUBLIC_BASE_URL=https://vjlivekit.com
# true = อีเวนต์ปลอม (ทดสอบ overlay โดยไม่ต้องไลฟ์จริง)
DEMO_MODE=false

# PostgreSQL (รหัสใน DATABASE_URL ต้องตรงกับ POSTGRES_PASSWORD)
POSTGRES_USER=vjlivekit
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=vjlivekit
DATABASE_URL=postgresql://vjlivekit:change-me-long-random@postgres:5432/vjlivekit?schema=public

# สุ่มด้วย: openssl rand -hex 32  (ต้องยาว >= 32 ตัวอักษร ไม่งั้นเซิร์ฟเวอร์ไม่สตาร์ท)
JWT_SECRET=
OVERLAY_TOKEN_TTL_DAYS=365

# TikTok sign server (EulerStream) — จำเป็นสำหรับต่อไลฟ์จริง
SIGN_API_KEY=

# Billing: none | stripe
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# (ออปชัน) price id ของแพลน Pro รายเดือน — ไม่ใส่จะสร้างราคาจากแพลนในโค้ด (149 บาท) ให้อัตโนมัติ
STRIPE_PRICE_PRO_MONTHLY=

# image ที่ใช้ (deploy.yml ตั้งให้อัตโนมัติ)
APP_IMAGE=ghcr.io/tueyzzzz/vjlivekit.com:latest
