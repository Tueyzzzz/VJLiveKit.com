# Caddy — reverse proxy + HTTPS อัตโนมัติ (Let's Encrypt)
# รองรับ WebSocket (Socket.IO) ให้เองโดยไม่ต้องตั้งอะไรเพิ่ม

{$DOMAIN} {
	encode zstd gzip
	# ระหว่างสลับแอปตอน deploy: ต่อไม่ได้ → ลองซ้ำ/สลับไปตัวที่พร้อมได้สูงสุด 20 วินาที (ไม่ขึ้นหน้า error)
	reverse_proxy app:8080 {
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}

# รองรับ www -> redirect ไปโดเมนหลัก
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri}
}
