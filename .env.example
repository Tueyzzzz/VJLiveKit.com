# ---------- Server ----------
PORT=8080
NODE_ENV=development
# เปิดโหมดเดโม (สร้างอีเวนต์ปลอม ไม่ต้องต่อ TikTok จริง)
DEMO_MODE=true

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://vjlivekit:vjlivekit@localhost:5432/vjlivekit?schema=public"

# ---------- Redis (เพิ่มตอนสเกล — ไม่ใส่ก็ได้ใน v1) ----------
REDIS_URL="redis://localhost:6379"

# ---------- Auth ----------
JWT_SECRET="change-me-to-a-long-random-string"
# อายุ token ของ overlay (วัน)
OVERLAY_TOKEN_TTL_DAYS=365

# ---------- TikTok sign server (EulerStream) ----------
# ขอฟรีได้ที่ https://www.eulerstream.com/ (เว้นว่างได้ library จะใช้ค่าเริ่มต้น)
SIGN_API_KEY=

# ---------- Billing (เลือก provider ภายหลัง: stripe | omise | none) ----------
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=

# URL ฝั่งหน้าเว็บ (ใช้ประกอบลิงก์ overlay/redirect)
PUBLIC_BASE_URL=http://localhost:8080
