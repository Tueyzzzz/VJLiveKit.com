{
  "name": "tikfinity-studio",
  "version": "0.1.0",
  "private": true,
  "description": "TikFinity-style TikTok LIVE widget platform (coinjar, alerts, goals, chat, TTS) — production monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tikfinity/server",
    "build": "npm run build --workspace @tikfinity/server",
    "start": "npm run start --workspace @tikfinity/server",
    "prisma:generate": "npm run prisma:generate --workspace @tikfinity/server",
    "prisma:migrate": "npm run prisma:migrate --workspace @tikfinity/server",
    "typecheck": "tsc -p packages/server/tsconfig.json --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
